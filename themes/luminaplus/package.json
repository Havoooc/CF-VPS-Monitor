{
  "name": "cfsm-theme-luminaplus",
  "private": true,
  "version": "1.2.27",
  "type": "module",
  "packageManager": "npm@11",
  "description": "Built-in LuminaPlus default theme for CF-VPS-Monitor",
  "author": "codex&shark&shanyang",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
